# Example configuration for GeoIP Custom IP Blocker
# Copy this file to .env and update with your actual values

# DefensePro Configuration
# CC_IP: CyberController IP address (single controller manages all DefensePro devices)
CC_IP=192.168.1.100

# DP_IPS: Comma-separated list of DefensePro device IP addresses
# For multiple devices, separate with commas
# Example: DP_IPS=192.168.1.50,192.168.1.51,192.168.1.52
DP_IPS=192.168.1.50,192.168.1.51,192.168.1.52

# CyberController credentials
CC_USERNAME=radware
CC_PASSWORD=radware

# SSL verification (typically false for self-signed certificates)
VERIFY_SSL=false

# Radware GeoIP Source
RADWARE_API_URL=https://services.radware.com/api/geodb/getfile

# Target Regions for IP Range Identification
# UA = Ukraine, specific subdivisions for occupied territories
TARGET_COUNTRY=UA

# TARGET_REGIONS: Optional - specific subdivision ISO codes to filter (e.g., 43,09,14)
#                 If omitted or commented out, includes ALL subdivisions for TARGET_COUNTRY
#                 If specified, only networks in those subdivisions will be included
#                 Example for Ukraine occupied territories: 43,09,14 (Crimea, Donetsk, Luhansk)
TARGET_REGIONS=43,09,14

# Optional: Step Control Configuration
# These flags allow selective enabling/disabling of workflow steps for testing and validation
# All flags default to 'true' when not specified

# ENABLE_GEODB_DOWNLOAD: Download GeoIP database from Radware API
#   true  = Download fresh database and process (normal operation)
#   false = Use existing cached database only (fails if no cache exists)
#   Use case: Skip download step when testing with existing cached data
ENABLE_GEODB_DOWNLOAD=true

# Optional: Force Download (for testing) -not applicable if ENABLE_GEODB_DOWNLOAD=false
# Set to true to bypass cache and force fresh database download
# Useful for testing even when cached database matches API MD5
FORCE_DOWNLOAD=false

# FILTER_TARGET_REGIONS: Filter GeoIP data by target regions (TARGET_COUNTRY and TARGET_REGIONS)
#   true  = Filter GeoIP database by specified regions (normal operation)
#   false = Skip region filtering, loads from data/original_network_ranges.csv from previous run.
#   Use case: Test with pre-exported CSV data without re-processing GeoIP database
#         
FILTER_TARGET_REGIONS=true


# ENABLE_NETWORK_SUMMARIZATION: Aggregate network ranges to reduce count
#   true  = Summarize networks (e.g., 760 networks → 87 networks via CIDR aggregation)
#   false = Use original filtered networks without summarization (/data/original_network_ranges.csv)
#   Use case: Test with full original network list or validate summarization results
ENABLE_NETWORK_SUMMARIZATION=true

# CONFIGURE_DEFENSEPRO: Push network configurations to DefensePro devices
#   true  = Connect to DefensePro and create network classes/blocklists (normal operation)
#   false = Skip DefensePro operations, only process data and export to CSV
#   Use case: Dry-run to validate data extraction and CSV exports before pushing to devices
CONFIGURE_DEFENSEPRO=true

# CONFIGURE_DEFENSEPRO_MODE: How to apply DefensePro configuration changes
#   OVERWRITE = Delete all existing user_defined_feed_* configurations, create fresh (default)
#               - Faster initial deployment and clean slate
#               - Brief gap when blocklists are removed and recreated (networks temporarily permitted)
#               - Best for: Initial setup, major configuration changes
#   
#   MERGE     = Incremental update - only add/delete changed networks
#               - No blocking gap (networks stay blocked during update)
#               - Only modifies what changed (faster for small updates)
#               - Fills gaps in existing network classes before creating new ones
#               - Maintains existing configuration structure
#               - Best for: Scheduled updates, minimal changes expected
#
# Default: OVERWRITE (maintains backward compatibility and clean state)
CONFIGURE_DEFENSEPRO_MODE=MERGE




# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./tmp/geo-ip-blocker.log
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514

# Storage Paths
GEODB_CACHE_DIR=./tmp/geodb_cache

# Cache Management
# CACHE_RETENTION_COUNT: Number of cached database versions to keep (older versions are deleted)
# Each cache version is ~230MB (locations.csv + blocks_ipv4.csv)
# Default: 3 (keeps last 3 database versions, ~690MB total)
# Set to 1 to keep only the current version, or higher for more history
CACHE_RETENTION_COUNT=3


# Optional: DefensePro Timeout Configuration (seconds)
# DP_API_TIMEOUT: Timeout for DefensePro CyberController API operations
#                 (network creation, blocklist configuration, device lock/unlock)
# DP_DELETE_TIMEOUT: Timeout for DefensePro bulk delete operations
#                    (deleting 250 networks can take longer than standard operations)
DP_API_TIMEOUT=30
DP_DELETE_TIMEOUT=120

# Optional: GeoIP Database Timeout Configuration (seconds)
# GEODB_API_TIMEOUT: Timeout for Radware GeoIP API metadata calls
#                    (retrieving database info, MD5 hash, download URL)
# GEODB_DOWNLOAD_TIMEOUT: Timeout for downloading GeoIP database ZIP file
#                         (file size ~78MB, may take several minutes on slow connections)
GEODB_API_TIMEOUT=30
GEODB_DOWNLOAD_TIMEOUT=300

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

# Optional: Network Class Configuration
# MAX_NETWORKS_PER_CLASS: Maximum number of networks per DefensePro network class (1-256)
# DefensePro supports up to 256 networks per class. Lower values create more classes.
# Default: 250 (conservative limit to avoid edge cases)
# Recommended: 250-256
MAX_NETWORKS_PER_CLASS=256

# Optional: Storage Paths
# CHANGES_LOG_FILE: CSV file to track all network additions/deletions with details
#                   Includes: timestamp, device IP, operation, network CIDR, blocklist, class, subindex, mode
CHANGES_LOG_FILE=./data/changes_log.csv

# Optional: Parallel Execution Configuration
# PARALLEL_EXECUTION: Enable parallel network creation (true/false)
# PARALLEL_WORKERS: Number of concurrent workers for parallel operations (1-50)
# Sequential mode (PARALLEL_EXECUTION=false) creates networks one-by-one
# Parallel mode significantly improves performance for large network sets
PARALLEL_EXECUTION=true
PARALLEL_WORKERS=10
